6<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Activar compte – SprintOps</title>
</head>
<body>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function(user) {
        if (user) {
          // Ja està confirmat i amb sessió, redirigeix al CMS
          document.location.href = "/admin/";
        }
      });
      window.netlifyIdentity.on("login", function(user) {
        // Un cop iniciada la sessió (o creat el compte), redirigeix
        document.location.href = "/admin/";
      });
      window.netlifyIdentity.init();
    } else {
      document.body.innerHTML = "Error: No s'ha pogut carregar el widget d'identitat.";
    }
  </script>
</body>
</html>
